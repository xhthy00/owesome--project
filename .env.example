# Application
APP_NAME=awesome-project
DEBUG=false
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/awesome

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM (optional for local development)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5

# Multi-turn: how many prior user-question rounds to replay from chat_log (SQLBot-aligned)
# GENERATE_SQL_QUERY_HISTORY_ROUND_COUNT=3

# Education clarification: LLM-based intent slot extraction (DB-GPT-aligned).
# Set to false to fall back to rule-only slot extraction.
# EDU_LLM_SLOT_EXTRACTION=true
